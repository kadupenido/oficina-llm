# ---------------------------------------------------------------------------
# Este repositório é só o aplicativo de chat (UI + FastAPI + SQLite).
# A inferência fica no projeto Nook: https://github.com/kadupenido/nook
# Suba o Nook no host e aponte LLAMA_BASE_URL para a API compatível com OpenAI.
# ---------------------------------------------------------------------------

# API de inferência (OpenAI-compatible). Ex.: http://127.0.0.1:9080/v1
# No Docker Desktop (Windows/macOS), o compose usa host.docker.internal para alcançar o host.
LLAMA_BASE_URL=http://127.0.0.1:9080/v1

# Obrigatório: Bearer enviado ao upstream (Authorization: Bearer ...).
LLAMA_API_KEY=

# Id do modelo. Vazio = usa o primeiro id retornado por GET /v1/models.
LLAMA_MODEL=

LLAMA_TIMEOUT_SECONDS=300
LLAMA_ENABLE_THINKING=false

# Janela de contexto usada pelo backend para orçamento e barra lateral.
# Ajuste para bater com o limite real do modelo no Nook.
LLAMA_CTX_SIZE=8192

# Quantas gerações podem correr ao mesmo tempo neste processo FastAPI (semáforo → 503 se esgotar).
# Não é flag do servidor de inferência; só limita carga no backend. Default 1 se omitir.
LLAMA_PARALLEL=1

MAX_TOKENS_DEFAULT=2048
MESSAGE_OVERHEAD_TOKENS=4
CONTEXT_RESERVE_TOKENS=256
CHARS_PER_TOKEN=2.5
SYSTEM_PROMPT=Você é um assistente útil. Responda no idioma do usuário, de forma clara e direta.

# Backend. No Docker Compose, DATABASE_URL é sobrescrito para o volume.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Opcional: protege as rotas /api/* deste FastAPI (não confundir com LLAMA_API_KEY).
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Busca na web (Tavily). Exige que o upstream suporte tools (function calling).
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_CHARS=12000
AGENT_MAX_TOOL_ROUNDS=3

# Upload de arquivos (texto/código/PDF). Só o texto extraído vai para o SQLite.
FILE_UPLOAD_ENABLED=true
FILE_UPLOAD_MAX_BYTES=5000000
FILE_UPLOAD_MAX_FILES=5
FILE_UPLOAD_MAX_CHARS=100000

# Timeout do proxy nginx -> backend (frontend em Docker). Opcional no compose.
UPSTREAM_TIMEOUT_SECONDS=300
