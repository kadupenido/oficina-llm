# llama-server (publicado só em 127.0.0.1 no host). Roda só em GPU NVIDIA (RTX 4050 6 GB).
LLAMA_PORT=8080
LLAMA_CTX_SIZE=65536
LLAMA_THREADS=4
LLAMA_PARALLEL=1
LLAMA_KV_CACHE_TYPE=q8_0
LLAMA_BATCH_SIZE=1024
LLAMA_UBATCH_SIZE=512
LLAMA_HF_REPO=unsloth/Qwen3.5-4B-GGUF:Q4_K_M

# Backend. No Docker Compose, LLAMA_BASE_URL e DATABASE_URL são sobrescritos.
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_API_KEY=local
LLAMA_MODEL=
LLAMA_TIMEOUT_SECONDS=300
LLAMA_ENABLE_THINKING=false
MAX_TOKENS_DEFAULT=2048
MESSAGE_OVERHEAD_TOKENS=4
CONTEXT_RESERVE_TOKENS=256
CHARS_PER_TOKEN=2.5
SYSTEM_PROMPT=Você é um assistente útil. Responda no idioma do usuário, de forma clara e direta.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Busca na web (Tavily). Chave só no servidor.
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_CHARS=12000
AGENT_MAX_TOOL_ROUNDS=3

# Upload de arquivos (texto/código/PDF). Só o texto extraído vai para o SQLite.
FILE_UPLOAD_ENABLED=true
FILE_UPLOAD_MAX_BYTES=5000000
FILE_UPLOAD_MAX_FILES=5
FILE_UPLOAD_MAX_CHARS=100000
